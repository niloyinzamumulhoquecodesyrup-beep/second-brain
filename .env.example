# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string (Supabase pooler works well here)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Only needed when running `npm run seed:user` to create/update the single account.
SEED_EMAIL=you@example.com
SEED_PASSWORD=choose_a_strong_password

# Supabase project URL + anon key, used client-side (browser bundle) so the "Other
# Brains" tab can subscribe to Realtime updates directly against Supabase. Safe to
# expose: every table it can reach has RLS locked down to deny-all except explicit
# public-read policies on other_brains_messages/suggestions/books (see
# migrations/020_rls_lockdown.sql and 021_other_brains.sql). Find these under
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_anon_key

# Metered TURN relay for Mindcord's WebRTC mesh (voice/video). Server-side only --
# fetched by pages/api/mindcord/turn-credentials.js, which mints a short-lived
# credential with this key and resolves it to an ICE servers array; the secret itself
# never reaches the client. METERED_DOMAIN is your app name from the Metered dashboard
# home page (forms https://<name>.metered.live). METERED_SECRET_KEY is the
# account-scoped key from Dashboard > Developers (NOT the credential-scoped "apiKey"
# Metered returns elsewhere -- that one's front-end-safe, this one isn't).
METERED_DOMAIN=your_subdomain.metered.live
METERED_SECRET_KEY=replace_with_your_metered_secret_key

# Google Gemini API key, used server-side only by lib/gemini.js to power
# POST /api/tasks/breakdown (AI task breakdown). Get one at
# https://aistudio.google.com/apikey. Never expose this to the client.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Groq API key, used server-side only by lib/groq.js to power POST
# /api/voice/classify (voice capture -> task/PARA capture). The mobile app runs
# on-device speech-to-text and sends only the transcript text here; no audio
# reaches this backend. Get one at https://console.groq.com/keys. Never expose
# this to the client.
GROQ_API_KEY=replace_with_your_groq_api_key
